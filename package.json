{
	"name": "refract-ui",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Standalone visualization UI for Refract \u2014 load JSONL, render timelines, diffs, citations",
	"license": "AGPL-3.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/refract-org/refract-ui.git"
	},
	"homepage": "https://github.com/refract-org/refract-ui#readme",
	"bugs": {
		"url": "https://github.com/refract-org/refract-ui/issues"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"lint": "biome check .",
		"format": "biome format --write .",
		"prepare": "husky",
		"assets:check": "bun run scripts/check-assets.ts",
		"assets:generate": "bun run scripts/generate-scenes.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.5",
		"typescript": "^5.7.0",
		"vite": "^6.0.0",
		"vitest": "^4.1.7"
	}
}
